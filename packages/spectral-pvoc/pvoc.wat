;; lock(half, A, S, freqPerBin, mags): lockAdvance's frame with whole hops (pvoc.js) on one lockState's memory: with
;; `mags`, this frame's magnitudes first; the peaks and the lock map; the free bins advanced, the centre's turns from the
;; table and the rest by fdlibm's atan2, sin and cos in basic float ops, two bins to a float64x2; each peak's rotation
;; over its region; then, two bins at a time, the locked bins rotated, the state on to this frame and the synthesis bins
;; in place of the analysis ones. The same float64 ops in the same order as lockMap and lockAdvance in JS, a branch's
;; arms both taken and one kept where JS takes one: the same bits. A free bin at DC, at Nyquist, or zero in this frame or
;; the one before takes Math's atan2, cos and sin (imports), as in JS.
;; wat2wasm pvoc.wat -o pvoc.wasm && node scripts/wasm.js
;; Memory, n = half + 1 bins, each array of f64 B = 8·n2 bytes (n2: n + 1 rounded up to even): re im mag xr xi xm ur ui, the
;; free bins' y x q cos sin, the regions' rotation re im, at 0, B … 14B; the turns' cos and sin (N = 2·half each) at 15B
;; and 15B + 8N; then int32 n2 each: owner, the free bins by the table, the other free bins, the peaks. A joint state's
;; arrays after them, from byte J (ref and turn, below).
(module
  (import "m" "atan2" (func $matan2 (param f64 f64) (result f64)))
  (import "m" "cos" (func $mcos (param f64) (result f64)))
  (import "m" "sin" (func $msin (param f64) (result f64)))
  (memory (export "memory") 1)
  (global $nt (mut i32) (i32.const 0))
  (global $ne (mut i32) (i32.const 0))
  (global $np (mut i32) (i32.const 0))

  ;; truthiness of a float in JS: nonzero and not NaN
  (func $on (param $x f64) (result i32)
    (i32.and (f64.ne (local.get $x) (f64.const 0)) (f64.eq (local.get $x) (local.get $x))))

  ;; wrapPhase: p − floor(p / 2π + 0.5)·2π
  (func $wrap (param $p f64) (result f64)
    (f64.sub (local.get $p)
      (f64.mul (f64.floor (f64.add (f64.div (local.get $p) (f64.const 6.283185307179586)) (f64.const 0.5)))
        (f64.const 6.283185307179586))))

  ;; Math.round of each lane: the nearer integer, halves up, the sign kept (−0 for [−0.5, 0))
  (func $round (param $x v128) (result v128)
    (local $f v128)
    (local.set $f (f64x2.floor (local.get $x)))
    (local.set $f (f64x2.add (local.get $f)
      (v128.and (f64x2.ge (f64x2.sub (local.get $x) (local.get $f)) (v128.const f64x2 0.5 0.5)) (v128.const f64x2 1 1))))
    (v128.bitselect (local.get $x) (local.get $f) (v128.const i64x2 0x8000000000000000 0x8000000000000000)))

  ;; sink, cosk: sin and cos of |x| ≤ π/4 (fdlibm k_sin.c, k_cos.c), each lane
  (func $sink (param $x v128) (result v128)
    (local $z v128)
    (local.set $z (f64x2.mul (local.get $x) (local.get $x)))
    (f64x2.add (local.get $x)
      (f64x2.mul (f64x2.mul (local.get $z) (local.get $x))
        (f64x2.add (v128.const f64x2 -1.66666666666666324348e-01 -1.66666666666666324348e-01) (f64x2.mul (local.get $z)
        (f64x2.add (v128.const f64x2 8.33333333332248946124e-03 8.33333333332248946124e-03) (f64x2.mul (local.get $z)
        (f64x2.add (v128.const f64x2 -1.98412698298579493134e-04 -1.98412698298579493134e-04) (f64x2.mul (local.get $z)
        (f64x2.add (v128.const f64x2 2.75573137070700676789e-06 2.75573137070700676789e-06) (f64x2.mul (local.get $z)
        (f64x2.add (v128.const f64x2 -2.50507602534068634195e-08 -2.50507602534068634195e-08) (f64x2.mul (local.get $z)
          (v128.const f64x2 1.58969099521155010221e-10 1.58969099521155010221e-10))))))))))))))
  (func $cosk (param $x v128) (result v128)
    (local $z v128) (local $r v128) (local $h v128) (local $w v128)
    (local.set $z (f64x2.mul (local.get $x) (local.get $x)))
    (local.set $r (f64x2.mul (local.get $z)
      (f64x2.add (v128.const f64x2 4.16666666666666019037e-02 4.16666666666666019037e-02) (f64x2.mul (local.get $z)
      (f64x2.add (v128.const f64x2 -1.38888888888741095749e-03 -1.38888888888741095749e-03) (f64x2.mul (local.get $z)
      (f64x2.add (v128.const f64x2 2.48015872894767294178e-05 2.48015872894767294178e-05) (f64x2.mul (local.get $z)
      (f64x2.add (v128.const f64x2 -2.75573143513906633035e-07 -2.75573143513906633035e-07) (f64x2.mul (local.get $z)
      (f64x2.add (v128.const f64x2 2.08757232129817482790e-09 2.08757232129817482790e-09) (f64x2.mul (local.get $z)
        (v128.const f64x2 -1.13596475577881948265e-11 -1.13596475577881948265e-11)))))))))))))
    (local.set $h (f64x2.mul (v128.const f64x2 0.5 0.5) (local.get $z)))
    (local.set $w (f64x2.sub (v128.const f64x2 1 1) (local.get $h)))
    (f64x2.add (local.get $w)
      (f64x2.add (f64x2.sub (f64x2.sub (v128.const f64x2 1 1) (local.get $w)) (local.get $h)) (f64x2.mul (local.get $z) (local.get $r)))))

  ;; atan2(y, x) of nonzero (x, y), each lane: the octant by min/max, atan on |u| ≤ tan(π/8) by fdlibm's polynomial
  ;; (s_atan.c), the octant's angle added back with its low part
  (func $atan2 (param $y v128) (param $x v128) (result v128)
    (local $ax v128) (local $ay v128) (local $t v128) (local $big v128) (local $u v128) (local $z v128) (local $w v128)
    (local $p v128) (local $r v128)
    (local.set $ax (f64x2.abs (local.get $x)))
    (local.set $ay (f64x2.abs (local.get $y)))
    (local.set $t (f64x2.div (f64x2.min (local.get $ax) (local.get $ay)) (f64x2.max (local.get $ax) (local.get $ay))))
    (local.set $big (f64x2.gt (local.get $t) (v128.const f64x2 0.41421356237309515 0.41421356237309515)))
    (local.set $u (v128.bitselect
      (f64x2.div (f64x2.sub (local.get $t) (v128.const f64x2 1 1)) (f64x2.add (local.get $t) (v128.const f64x2 1 1)))
      (local.get $t) (local.get $big)))
    (local.set $z (f64x2.mul (local.get $u) (local.get $u)))
    (local.set $w (f64x2.mul (local.get $z) (local.get $z)))
    (local.set $p (f64x2.mul (local.get $u)
      (f64x2.add
        (f64x2.mul (local.get $z)
          (f64x2.add (v128.const f64x2 3.33333333333329318027e-01 3.33333333333329318027e-01) (f64x2.mul (local.get $w)
          (f64x2.add (v128.const f64x2 1.42857142725034663711e-01 1.42857142725034663711e-01) (f64x2.mul (local.get $w)
          (f64x2.add (v128.const f64x2 9.09088713343650656196e-02 9.09088713343650656196e-02) (f64x2.mul (local.get $w)
          (f64x2.add (v128.const f64x2 6.66107313738753120669e-02 6.66107313738753120669e-02) (f64x2.mul (local.get $w)
          (f64x2.add (v128.const f64x2 4.97687799461593236017e-02 4.97687799461593236017e-02) (f64x2.mul (local.get $w)
            (v128.const f64x2 1.62858201153657823623e-02 1.62858201153657823623e-02))))))))))))
        (f64x2.mul (local.get $w)
          (f64x2.add (v128.const f64x2 -1.99999999998764832476e-01 -1.99999999998764832476e-01) (f64x2.mul (local.get $w)
          (f64x2.add (v128.const f64x2 -1.11111104054623557880e-01 -1.11111104054623557880e-01) (f64x2.mul (local.get $w)
          (f64x2.add (v128.const f64x2 -7.69187620504482999495e-02 -7.69187620504482999495e-02) (f64x2.mul (local.get $w)
          (f64x2.add (v128.const f64x2 -5.83357013379057348645e-02 -5.83357013379057348645e-02) (f64x2.mul (local.get $w)
            (v128.const f64x2 -3.65315727442169155270e-02 -3.65315727442169155270e-02)))))))))))))
    (local.set $r (v128.bitselect
      (f64x2.sub (v128.const f64x2 0.7853981633974483 0.7853981633974483)
        (f64x2.sub (f64x2.sub (local.get $p) (v128.const f64x2 3.06161699786838301793e-17 3.06161699786838301793e-17)) (local.get $u)))
      (f64x2.sub (local.get $u) (local.get $p))
      (local.get $big)))
    (local.set $r (v128.bitselect
      (f64x2.sub (v128.const f64x2 1.5707963267948966 1.5707963267948966)
        (f64x2.sub (local.get $r) (v128.const f64x2 6.123233995736766e-17 6.123233995736766e-17)))
      (local.get $r) (f64x2.gt (local.get $ay) (local.get $ax))))
    (local.set $r (v128.bitselect
      (f64x2.sub (v128.const f64x2 3.141592653589793 3.141592653589793)
        (f64x2.sub (local.get $r) (v128.const f64x2 1.2246467991473532e-16 1.2246467991473532e-16)))
      (local.get $r) (f64x2.lt (local.get $x) (v128.const f64x2 0 0))))
    (v128.bitselect (f64x2.neg (local.get $r)) (local.get $r) (f64x2.lt (local.get $y) (v128.const f64x2 0 0))))

  ;; peakList then lockMap (pvoc.js): the peaks in order at pk ($np), owner[k] the peak bin k takes the rotation of or −1,
  ;; the free bins listed in order, those the table serves at ft ($nt), the others at fe ($ne)
  (func $map (param $half i32) (param $mag i32) (param $xm i32) (param $own i32) (param $ft i32) (param $fe i32) (param $pk i32)
    (local $k i32) (local $n i32) (local $i i32) (local $p i32) (local $start i32) (local $end i32) (local $last i32)
    (local $nt i32) (local $ne i32) (local $best i32) (local $o i32) (local $lock i32) (local $tab i32)
    (local $v f64) (local $w f64) (local $max f64) (local $minMag f64) (local $minProm f64) (local $lastMag f64) (local $sh f64) (local $floor f64)
    (local.set $k (i32.const 0))
    (loop $m
      (local.set $v (f64.load (i32.add (local.get $mag) (i32.shl (local.get $k) (i32.const 3)))))
      (if (f64.gt (local.get $v) (local.get $max)) (then (local.set $max (local.get $v))))
      (br_if $m (i32.le_s (local.tee $k (i32.add (local.get $k) (i32.const 1))) (local.get $half))))
    (local.set $minMag (f64.max (f64.const 1e-8) (f64.mul (local.get $max) (f64.const 0.015))))
    (local.set $minProm (f64.max (f64.const 1e-9) (f64.mul (local.get $max) (f64.const 0.003))))
    (local.set $last (i32.const -2))
    (local.set $k (i32.const 1))
    (block $done (loop $scan
      (br_if $done (i32.ge_s (local.get $k) (local.get $half)))
      (block $next
        (local.set $o (i32.add (local.get $mag) (i32.shl (local.get $k) (i32.const 3))))
        (local.set $v (f64.load (local.get $o)))
        (br_if $next (f64.lt (local.get $v) (local.get $minMag)))
        (br_if $next (f64.lt (local.get $v) (f64.load offset=0 (i32.sub (local.get $o) (i32.const 8)))))
        (br_if $next (f64.lt (local.get $v) (f64.load offset=8 (local.get $o))))
        ;; Math.max(mag[k − 1], mag[k + 1], k > 1 ? mag[k − 2] : 0, k + 2 ≤ half ? mag[k + 2] : 0)
        (local.set $sh (f64.max
          (f64.max (f64.load (i32.sub (local.get $o) (i32.const 8))) (f64.load offset=8 (local.get $o)))
          (f64.max
            (if (result f64) (i32.gt_s (local.get $k) (i32.const 1))
              (then (f64.load (i32.sub (local.get $o) (i32.const 16)))) (else (f64.const 0)))
            (if (result f64) (i32.le_s (i32.add (local.get $k) (i32.const 2)) (local.get $half))
              (then (f64.load offset=16 (local.get $o))) (else (f64.const 0))))))
        (br_if $next (i32.and
          (f64.lt (f64.sub (local.get $v) (local.get $sh)) (local.get $minProm))
          (f64.lt (local.get $v) (f64.mul (local.get $max) (f64.const 0.1)))))
        (if (i32.le_s (i32.sub (local.get $k) (local.get $last)) (i32.const 1))
          (then
            (if (f64.gt (local.get $v) (local.get $lastMag))
              (then
                (i32.store (i32.add (local.get $pk) (i32.shl (i32.sub (local.get $n) (i32.const 1)) (i32.const 2))) (local.get $k))
                (local.set $last (local.get $k))
                (local.set $lastMag (local.get $v))))
            (br $next)))
        (i32.store (i32.add (local.get $pk) (i32.shl (local.get $n) (i32.const 2))) (local.get $k))
        (local.set $n (i32.add (local.get $n) (i32.const 1)))
        (local.set $last (local.get $k))
        (local.set $lastMag (local.get $v)))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br $scan)))
    (if (i32.eqz (local.get $n))
      (then
        (local.set $k (i32.const 1))
        (loop $b
          (if (f64.gt (f64.load (i32.add (local.get $mag) (i32.shl (local.get $k) (i32.const 3))))
                      (f64.load (i32.add (local.get $mag) (i32.shl (local.get $best) (i32.const 3)))))
            (then (local.set $best (local.get $k))))
          (br_if $b (i32.le_s (local.tee $k (i32.add (local.get $k) (i32.const 1))) (local.get $half))))
        (i32.store (local.get $pk) (local.get $best))
        (local.set $n (i32.const 1))))
    ;; the regions tile 0…half, each from halfway to the peak before to halfway to the next
    (local.set $i (i32.const 0))
    (loop $r
      (local.set $p (i32.load (i32.add (local.get $pk) (i32.shl (local.get $i) (i32.const 2)))))
      (local.set $start (if (result i32) (local.get $i)
        (then (i32.add (i32.shr_s (i32.add (i32.load (i32.add (local.get $pk) (i32.shl (i32.sub (local.get $i) (i32.const 1)) (i32.const 2)))) (local.get $p)) (i32.const 1)) (i32.const 1)))
        (else (i32.const 0))))
      (local.set $end (if (result i32) (i32.eq (local.get $i) (i32.sub (local.get $n) (i32.const 1)))
        (then (local.get $half))
        (else (i32.shr_s (i32.add (local.get $p) (i32.load (i32.add (local.get $pk) (i32.shl (i32.add (local.get $i) (i32.const 1)) (i32.const 2))))) (i32.const 1)))))
      (local.set $floor (f64.max (f64.const 1e-10) (f64.mul (f64.load (i32.add (local.get $mag) (i32.shl (local.get $p) (i32.const 3)))) (f64.const 0.03))))
      (local.set $k (local.get $start))
      ;; without branches: owner the peak or −1, k appended to both free lists, each list's count grown by whether it is its
      (block $e (loop $l
        (br_if $e (i32.gt_s (local.get $k) (local.get $end)))
        (local.set $o (i32.shl (local.get $k) (i32.const 3)))
        (local.set $v (f64.load (i32.add (local.get $mag) (local.get $o))))
        (local.set $lock (i32.and (i32.ne (local.get $k) (local.get $p)) (i32.eqz (f64.lt (local.get $v) (local.get $floor)))))
        (i32.store (i32.add (local.get $own) (i32.shl (local.get $k) (i32.const 2)))
          (select (local.get $p) (i32.const -1) (local.get $lock)))
        (local.set $tab (i32.and
          (i32.and (i32.ne (local.get $k) (i32.const 0)) (i32.lt_s (local.get $k) (local.get $half)))
          ;; JS truthiness of both magnitudes, inline: nonzero and not NaN
          (i32.and
            (i32.and (f64.ne (local.get $v) (f64.const 0)) (f64.eq (local.get $v) (local.get $v)))
            (i32.and (f64.ne (local.tee $w (f64.load (i32.add (local.get $xm) (local.get $o)))) (f64.const 0)) (f64.eq (local.get $w) (local.get $w))))))
        (i32.store (i32.add (local.get $ft) (i32.shl (local.get $nt) (i32.const 2))) (local.get $k))
        (i32.store (i32.add (local.get $fe) (i32.shl (local.get $ne) (i32.const 2))) (local.get $k))
        (local.set $nt (i32.add (local.get $nt) (i32.and (i32.eqz (local.get $lock)) (local.get $tab))))
        (local.set $ne (i32.add (local.get $ne) (i32.and (i32.eqz (local.get $lock)) (i32.eqz (local.get $tab)))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $l)))
      (br_if $r (i32.lt_s (local.tee $i (i32.add (local.get $i) (i32.const 1))) (local.get $n))))
    (global.set $nt (local.get $nt))
    (global.set $ne (local.get $ne))
    (global.set $np (local.get $n)))

  (func (export "lock") (param $half i32) (param $A i32) (param $S i32) (param $fpb f64) (param $mags i32)
    (local $n2 i32) (local $B i32) (local $N i32) (local $M i32) (local $end i32)
    (local $re i32) (local $im i32) (local $mag i32) (local $xr i32) (local $xi i32) (local $xm i32) (local $ur i32) (local $ui i32)
    (local $Y i32) (local $X i32) (local $Q i32) (local $CR i32) (local $SR i32) (local $RR i32) (local $RI i32)
    (local $tc i32) (local $ts i32) (local $own i32) (local $ft i32) (local $fe i32) (local $pk i32)
    (local $i i32) (local $k i32) (local $o i32) (local $m i32) (local $j i32) (local $p i32) (local $nt i32) (local $ne i32) (local $np i32)
    (local $start i32) (local $stop i32)
    (local $fA f64) (local $fS f64) (local $u f64) (local $v f64) (local $c f64) (local $s f64)
    (local $xre f64) (local $xim f64) (local $pr f64) (local $pi f64) (local $mk f64) (local $pm f64)
    (local $dr f64) (local $di f64) (local $wc f64) (local $ws f64) (local $cr f64) (local $sr f64) (local $tcj f64) (local $tsj f64)
    (local $d f64) (local $a f64) (local $rr f64) (local $ri f64)
    (local $vA v128) (local $vS v128) (local $th v128) (local $q v128) (local $r v128)
    (local $vre v128) (local $vim v128) (local $vmag v128) (local $vrr v128) (local $vri v128) (local $iq v128) (local $lock v128)
    (local $vur v128) (local $vui v128)
    (local.set $n2 (i32.and (i32.add (local.get $half) (i32.const 3)) (i32.const -2)))
    (local.set $B (i32.shl (local.get $n2) (i32.const 3)))
    (local.set $N (i32.shl (local.get $half) (i32.const 1)))
    (local.set $M (i32.sub (local.get $N) (i32.const 1)))
    (local.set $im (local.get $B))
    (local.set $mag (i32.mul (local.get $B) (i32.const 2)))
    (local.set $xr (i32.mul (local.get $B) (i32.const 3)))
    (local.set $xi (i32.mul (local.get $B) (i32.const 4)))
    (local.set $xm (i32.mul (local.get $B) (i32.const 5)))
    (local.set $ur (i32.mul (local.get $B) (i32.const 6)))
    (local.set $ui (i32.mul (local.get $B) (i32.const 7)))
    (local.set $Y (i32.mul (local.get $B) (i32.const 8)))
    (local.set $X (i32.mul (local.get $B) (i32.const 9)))
    (local.set $Q (i32.mul (local.get $B) (i32.const 10)))
    (local.set $CR (i32.mul (local.get $B) (i32.const 11)))
    (local.set $SR (i32.mul (local.get $B) (i32.const 12)))
    (local.set $RR (i32.mul (local.get $B) (i32.const 13)))
    (local.set $RI (i32.mul (local.get $B) (i32.const 14)))
    (local.set $tc (i32.mul (local.get $B) (i32.const 15)))
    (local.set $ts (i32.add (local.get $tc) (i32.shl (local.get $N) (i32.const 3))))
    (local.set $own (i32.add (local.get $ts) (i32.shl (local.get $N) (i32.const 3))))
    (local.set $ft (i32.add (local.get $own) (i32.shl (local.get $n2) (i32.const 2))))
    (local.set $fe (i32.add (local.get $ft) (i32.shl (local.get $n2) (i32.const 2))))
    (local.set $pk (i32.add (local.get $fe) (i32.shl (local.get $n2) (i32.const 2))))
    ;; bytes of the n bins, two at a time
    (local.set $end (i32.shl (i32.add (local.get $half) (i32.const 1)) (i32.const 3)))
    ;; the magnitudes, √(re² + im²)
    (if (local.get $mags) (then
      (local.set $o (i32.const 0))
      (loop $g
        (local.set $vre (v128.load (local.get $o)))
        (local.set $vim (v128.load (i32.add (local.get $im) (local.get $o))))
        (v128.store (i32.add (local.get $mag) (local.get $o))
          (f64x2.sqrt (f64x2.add (f64x2.mul (local.get $vre) (local.get $vre)) (f64x2.mul (local.get $vim) (local.get $vim)))))
        (br_if $g (i32.lt_s (local.tee $o (i32.add (local.get $o) (i32.const 16))) (local.get $end))))))
    (call $map (local.get $half) (local.get $mag) (local.get $xm) (local.get $own) (local.get $ft) (local.get $fe) (local.get $pk))
    (local.set $nt (global.get $nt))
    (local.set $ne (global.get $ne))
    (local.set $np (global.get $np))
    (local.set $fA (f64.convert_i32_s (local.get $A)))
    (local.set $fS (f64.convert_i32_s (local.get $S)))
    ;; the free bins the table serves: X·conj(Xprev) rotated back by the centre's ω_k·A, e^(i·dp), its (y, x) gathered
    (local.set $i (i32.const 0))
    (block $gd (loop $gl
      (br_if $gd (i32.ge_s (local.get $i) (local.get $nt)))
      (local.set $k (i32.load (i32.add (local.get $ft) (i32.shl (local.get $i) (i32.const 2)))))
      (local.set $o (i32.shl (local.get $k) (i32.const 3)))
      (local.set $xre (f64.load (local.get $o)))
      (local.set $xim (f64.load (i32.add (local.get $im) (local.get $o))))
      (local.set $pr (f64.load (i32.add (local.get $xr) (local.get $o))))
      (local.set $pi (f64.load (i32.add (local.get $xi) (local.get $o))))
      (local.set $dr (f64.add (f64.mul (local.get $xre) (local.get $pr)) (f64.mul (local.get $xim) (local.get $pi))))
      (local.set $di (f64.sub (f64.mul (local.get $xim) (local.get $pr)) (f64.mul (local.get $xre) (local.get $pi))))
      (local.set $m (i32.shl (i32.and (i32.mul (local.get $k) (local.get $A)) (local.get $M)) (i32.const 3)))
      (local.set $wc (f64.load (i32.add (local.get $tc) (local.get $m))))
      (local.set $ws (f64.load (i32.add (local.get $ts) (local.get $m))))
      (local.set $o (i32.shl (local.get $i) (i32.const 3)))
      (f64.store (i32.add (local.get $Y) (local.get $o)) (f64.sub (f64.mul (local.get $di) (local.get $wc)) (f64.mul (local.get $dr) (local.get $ws))))
      (f64.store (i32.add (local.get $X) (local.get $o)) (f64.add (f64.mul (local.get $dr) (local.get $wc)) (f64.mul (local.get $di) (local.get $ws))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $gl)))
    ;; two at a time: the deviation's synthesis share th, its quarter turns q, and the rest r's cos and sin
    (local.set $vA (f64x2.splat (local.get $fA)))
    (local.set $vS (f64x2.splat (local.get $fS)))
    (local.set $o (i32.const 0))
    (local.set $m (i32.shl (local.get $nt) (i32.const 3)))
    (block $vd (loop $vl
      (br_if $vd (i32.ge_s (local.get $o) (local.get $m)))
      (local.set $th (f64x2.mul (f64x2.div
        (call $atan2 (v128.load (i32.add (local.get $Y) (local.get $o))) (v128.load (i32.add (local.get $X) (local.get $o))))
        (local.get $vA)) (local.get $vS)))
      (local.set $q (call $round (f64x2.mul (local.get $th) (v128.const f64x2 6.36619772367581382433e-01 6.36619772367581382433e-01))))
      (local.set $r (f64x2.sub
        (f64x2.sub (local.get $th) (f64x2.mul (local.get $q) (v128.const f64x2 1.57079632673412561417e+00 1.57079632673412561417e+00)))
        (f64x2.mul (local.get $q) (v128.const f64x2 6.07710050650619224932e-11 6.07710050650619224932e-11))))
      (v128.store (i32.add (local.get $Q) (local.get $o)) (local.get $q))
      (v128.store (i32.add (local.get $CR) (local.get $o)) (call $cosk (local.get $r)))
      (v128.store (i32.add (local.get $SR) (local.get $o)) (call $sink (local.get $r)))
      (local.set $o (i32.add (local.get $o) (i32.const 16)))
      (br $vl)))
    ;; on by the centre's ω_k·S and th: their quarter turns from the table, the rest by the kernels
    (local.set $i (i32.const 0))
    (block $sd (loop $sl
      (br_if $sd (i32.ge_s (local.get $i) (local.get $nt)))
      (local.set $k (i32.load (i32.add (local.get $ft) (i32.shl (local.get $i) (i32.const 2)))))
      (local.set $o (i32.shl (local.get $i) (i32.const 3)))
      (local.set $j (i32.shl (i32.and
        (i32.add (i32.mul (local.get $k) (local.get $S))
          (i32.mul (i32.trunc_sat_f64_s (f64.load (i32.add (local.get $Q) (local.get $o)))) (i32.shr_s (local.get $N) (i32.const 2))))
        (local.get $M)) (i32.const 3)))
      (local.set $cr (f64.load (i32.add (local.get $CR) (local.get $o))))
      (local.set $sr (f64.load (i32.add (local.get $SR) (local.get $o))))
      (local.set $tcj (f64.load (i32.add (local.get $tc) (local.get $j))))
      (local.set $tsj (f64.load (i32.add (local.get $ts) (local.get $j))))
      (local.set $c (f64.sub (f64.mul (local.get $tcj) (local.get $cr)) (f64.mul (local.get $tsj) (local.get $sr))))
      (local.set $s (f64.add (f64.mul (local.get $tcj) (local.get $sr)) (f64.mul (local.get $tsj) (local.get $cr))))
      (local.set $o (i32.shl (local.get $k) (i32.const 3)))
      (local.set $u (f64.load (i32.add (local.get $ur) (local.get $o))))
      (local.set $v (f64.load (i32.add (local.get $ui) (local.get $o))))
      (f64.store (i32.add (local.get $ur) (local.get $o)) (f64.sub (f64.mul (local.get $u) (local.get $c)) (f64.mul (local.get $v) (local.get $s))))
      (f64.store (i32.add (local.get $ui) (local.get $o)) (f64.add (f64.mul (local.get $u) (local.get $s)) (f64.mul (local.get $v) (local.get $c))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $sl)))
    ;; the other free bins: phase advance since the previous frame, arg(X·conj(Xprev)); a zero bin has no product angle:
    ;; its own angles
    (local.set $i (i32.const 0))
    (block $ed (loop $el
      (br_if $ed (i32.ge_s (local.get $i) (local.get $ne)))
      (local.set $k (i32.load (i32.add (local.get $fe) (i32.shl (local.get $i) (i32.const 2)))))
      (local.set $o (i32.shl (local.get $k) (i32.const 3)))
      (local.set $xre (f64.load (local.get $o)))
      (local.set $xim (f64.load (i32.add (local.get $im) (local.get $o))))
      (local.set $pr (f64.load (i32.add (local.get $xr) (local.get $o))))
      (local.set $pi (f64.load (i32.add (local.get $xi) (local.get $o))))
      (local.set $d (if (result f64) (i32.and (call $on (f64.load (i32.add (local.get $mag) (local.get $o)))) (call $on (f64.load (i32.add (local.get $xm) (local.get $o)))))
        (then (call $matan2
          (f64.sub (f64.mul (local.get $xim) (local.get $pr)) (f64.mul (local.get $xre) (local.get $pi)))
          (f64.add (f64.mul (local.get $xre) (local.get $pr)) (f64.mul (local.get $xim) (local.get $pi)))))
        (else (f64.sub (call $matan2 (local.get $xim) (local.get $xre)) (call $matan2 (local.get $pi) (local.get $pr))))))
      (local.set $d (call $wrap (f64.sub (local.get $d)
        (f64.mul (f64.mul (f64.convert_i32_s (local.get $k)) (local.get $fpb)) (local.get $fA)))))
      (local.set $a (f64.mul (f64.add (f64.mul (f64.convert_i32_s (local.get $k)) (local.get $fpb))
        (f64.div (local.get $d) (local.get $fA))) (local.get $fS)))
      (local.set $c (call $mcos (local.get $a)))
      (local.set $s (call $msin (local.get $a)))
      (local.set $u (f64.load (i32.add (local.get $ur) (local.get $o))))
      (local.set $v (f64.load (i32.add (local.get $ui) (local.get $o))))
      (f64.store (i32.add (local.get $ur) (local.get $o)) (f64.sub (f64.mul (local.get $u) (local.get $c)) (f64.mul (local.get $v) (local.get $s))))
      (f64.store (i32.add (local.get $ui) (local.get $o)) (f64.add (f64.mul (local.get $u) (local.get $s)) (f64.mul (local.get $v) (local.get $c))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $el)))
    ;; each region's rotation R = Y(p)·conj(X(p))/|X(p)| over the region, the peak's phasor advanced above
    (local.set $i (i32.const 0))
    (loop $rl
      (local.set $p (i32.load (i32.add (local.get $pk) (i32.shl (local.get $i) (i32.const 2)))))
      (local.set $start (if (result i32) (local.get $i)
        (then (i32.add (i32.shr_s (i32.add (i32.load (i32.add (local.get $pk) (i32.shl (i32.sub (local.get $i) (i32.const 1)) (i32.const 2)))) (local.get $p)) (i32.const 1)) (i32.const 1)))
        (else (i32.const 0))))
      (local.set $stop (if (result i32) (i32.eq (local.get $i) (i32.sub (local.get $np) (i32.const 1)))
        (then (local.get $half))
        (else (i32.shr_s (i32.add (local.get $p) (i32.load (i32.add (local.get $pk) (i32.shl (i32.add (local.get $i) (i32.const 1)) (i32.const 2))))) (i32.const 1)))))
      (local.set $o (i32.shl (local.get $p) (i32.const 3)))
      (local.set $mk (f64.load (i32.add (local.get $mag) (local.get $o))))
      (local.set $u (f64.load (i32.add (local.get $ur) (local.get $o))))
      (local.set $v (f64.load (i32.add (local.get $ui) (local.get $o))))
      (local.set $xre (f64.load (local.get $o)))
      (local.set $xim (f64.load (i32.add (local.get $im) (local.get $o))))
      (local.set $rr (f64.div (f64.add (f64.mul (local.get $u) (local.get $xre)) (f64.mul (local.get $v) (local.get $xim))) (local.get $mk)))
      (local.set $ri (f64.div (f64.sub (f64.mul (local.get $v) (local.get $xre)) (f64.mul (local.get $u) (local.get $xim))) (local.get $mk)))
      ;; two bins a store from the region's start; one past its end is the next region's to set, or the padding
      (local.set $vrr (f64x2.splat (local.get $rr)))
      (local.set $vri (f64x2.splat (local.get $ri)))
      (local.set $o (i32.shl (local.get $start) (i32.const 3)))
      (local.set $m (i32.shl (i32.add (local.get $stop) (i32.const 1)) (i32.const 3)))
      (loop $fl
        (v128.store (i32.add (local.get $RR) (local.get $o)) (local.get $vrr))
        (v128.store (i32.add (local.get $RI) (local.get $o)) (local.get $vri))
        (br_if $fl (i32.lt_s (local.tee $o (i32.add (local.get $o) (i32.const 16))) (local.get $m))))
      (br_if $rl (i32.lt_s (local.tee $i (i32.add (local.get $i) (i32.const 1))) (local.get $np))))
    ;; two bins at a time: a locked bin's phasor its peak's rotation over its own magnitude, (X·R)/|X|; the state on to
    ;; this frame; the synthesis bins, magnitude times phasor
    (local.set $o (i32.const 0))
    (loop $dl
      (local.set $vre (v128.load (local.get $o)))
      (local.set $vim (v128.load (i32.add (local.get $im) (local.get $o))))
      (local.set $vmag (v128.load (i32.add (local.get $mag) (local.get $o))))
      (local.set $vrr (v128.load (i32.add (local.get $RR) (local.get $o))))
      (local.set $vri (v128.load (i32.add (local.get $RI) (local.get $o))))
      (local.set $lock (i64x2.ge_s
        (i64x2.extend_low_i32x4_s (v128.load64_zero (i32.add (local.get $own) (i32.shr_u (local.get $o) (i32.const 1)))))
        (v128.const i64x2 0 0)))
      (local.set $iq (f64x2.div (v128.const f64x2 1 1) (local.get $vmag)))
      (local.set $vur (v128.bitselect
        (f64x2.mul (f64x2.sub (f64x2.mul (local.get $vre) (local.get $vrr)) (f64x2.mul (local.get $vim) (local.get $vri))) (local.get $iq))
        (v128.load (i32.add (local.get $ur) (local.get $o))) (local.get $lock)))
      (local.set $vui (v128.bitselect
        (f64x2.mul (f64x2.add (f64x2.mul (local.get $vre) (local.get $vri)) (f64x2.mul (local.get $vim) (local.get $vrr))) (local.get $iq))
        (v128.load (i32.add (local.get $ui) (local.get $o))) (local.get $lock)))
      (v128.store (i32.add (local.get $ur) (local.get $o)) (local.get $vur))
      (v128.store (i32.add (local.get $ui) (local.get $o)) (local.get $vui))
      (v128.store (i32.add (local.get $xr) (local.get $o)) (local.get $vre))
      (v128.store (i32.add (local.get $xi) (local.get $o)) (local.get $vim))
      (v128.store (i32.add (local.get $xm) (local.get $o)) (local.get $vmag))
      (v128.store (local.get $o) (f64x2.mul (local.get $vmag) (local.get $vur)))
      (v128.store (i32.add (local.get $im) (local.get $o)) (f64x2.mul (local.get $vmag) (local.get $vui)))
      (br_if $dl (i32.lt_s (local.tee $o (i32.add (local.get $o) (i32.const 16))) (local.get $end)))))

  ;; ref(half, nch, J), turn(half, nch, J): lockJoint's two passes (pvoc.js) around lock, on the same memory. At J the
  ;; reference's unit phase, re then im (B bytes each); from J + 2B each channel's four arrays: this frame's bins, re and
  ;; im, then the frame before's. Two bins to a float64x2, the same float64 ops in the same order as the JS, both arms
  ;; of its branches taken and one kept: the same bits.
  ;; ref: the channels' power and Σ X·conj(X′); the phase turned on by that sum's angle where it has one; this frame the
  ;; one before from here on; the root power into mag, the reference into re and im
  (func (export "ref") (param $half i32) (param $nch i32) (param $J i32)
    (local $B i32) (local $end i32) (local $o i32) (local $c i32) (local $q i32)
    (local $p v128) (local $cr v128) (local $ci v128) (local $a v128) (local $b v128) (local $pa v128) (local $pb v128)
    (local $m v128) (local $ur v128) (local $ui v128) (local $on v128) (local $nr v128) (local $ni v128)
    (local.set $B (i32.shl (i32.and (i32.add (local.get $half) (i32.const 3)) (i32.const -2)) (i32.const 3)))
    (local.set $end (i32.shl (i32.add (local.get $half) (i32.const 1)) (i32.const 3)))
    (loop $k
      (local.set $p (v128.const f64x2 0 0))
      (local.set $cr (v128.const f64x2 0 0))
      (local.set $ci (v128.const f64x2 0 0))
      (local.set $q (i32.add (i32.add (local.get $J) (i32.shl (local.get $B) (i32.const 1))) (local.get $o)))
      (local.set $c (i32.const 0))
      (loop $ch
        (local.set $a (v128.load (local.get $q)))
        (local.set $b (v128.load (i32.add (local.get $q) (local.get $B))))
        (local.set $pa (v128.load (i32.add (local.get $q) (i32.shl (local.get $B) (i32.const 1)))))
        (local.set $pb (v128.load (i32.add (local.get $q) (i32.mul (local.get $B) (i32.const 3)))))
        (local.set $p (f64x2.add (local.get $p) (f64x2.add (f64x2.mul (local.get $a) (local.get $a)) (f64x2.mul (local.get $b) (local.get $b)))))
        (local.set $cr (f64x2.add (local.get $cr) (f64x2.add (f64x2.mul (local.get $a) (local.get $pa)) (f64x2.mul (local.get $b) (local.get $pb)))))
        (local.set $ci (f64x2.add (local.get $ci) (f64x2.sub (f64x2.mul (local.get $b) (local.get $pa)) (f64x2.mul (local.get $a) (local.get $pb)))))
        (v128.store (i32.add (local.get $q) (i32.shl (local.get $B) (i32.const 1))) (local.get $a))
        (v128.store (i32.add (local.get $q) (i32.mul (local.get $B) (i32.const 3))) (local.get $b))
        (local.set $q (i32.add (local.get $q) (i32.shl (local.get $B) (i32.const 2))))
        (br_if $ch (i32.lt_s (local.tee $c (i32.add (local.get $c) (i32.const 1))) (local.get $nch))))
      (local.set $m (f64x2.sqrt (f64x2.add (f64x2.mul (local.get $cr) (local.get $cr)) (f64x2.mul (local.get $ci) (local.get $ci)))))
      (local.set $ur (v128.load (i32.add (local.get $J) (local.get $o))))
      (local.set $ui (v128.load (i32.add (i32.add (local.get $J) (local.get $B)) (local.get $o))))
      (local.set $on (f64x2.gt (local.get $m) (v128.const f64x2 0 0)))
      (local.set $nr (v128.bitselect
        (f64x2.div (f64x2.sub (f64x2.mul (local.get $ur) (local.get $cr)) (f64x2.mul (local.get $ui) (local.get $ci))) (local.get $m))
        (local.get $ur) (local.get $on)))
      (local.set $ni (v128.bitselect
        (f64x2.div (f64x2.add (f64x2.mul (local.get $ur) (local.get $ci)) (f64x2.mul (local.get $ui) (local.get $cr))) (local.get $m))
        (local.get $ui) (local.get $on)))
      (v128.store (i32.add (local.get $J) (local.get $o)) (local.get $nr))
      (v128.store (i32.add (i32.add (local.get $J) (local.get $B)) (local.get $o)) (local.get $ni))
      (local.set $m (f64x2.sqrt (local.get $p)))
      (v128.store (i32.add (i32.shl (local.get $B) (i32.const 1)) (local.get $o)) (local.get $m))
      (v128.store (local.get $o) (f64x2.mul (local.get $m) (local.get $nr)))
      (v128.store (i32.add (local.get $B) (local.get $o)) (f64x2.mul (local.get $m) (local.get $ni)))
      (br_if $k (i32.lt_s (local.tee $o (i32.add (local.get $o) (i32.const 16))) (local.get $end)))))

  ;; turn: the reference's rotation, its synthesis bin (re, im after lock) over its analysis one, Y·conj(X)/|X|², on
  ;; every channel's bin; a bin with no power stays
  (func (export "turn") (param $half i32) (param $nch i32) (param $J i32)
    (local $B i32) (local $end i32) (local $o i32) (local $c i32) (local $q i32)
    (local $m v128) (local $on v128) (local $re v128) (local $im v128) (local $fr v128) (local $fi v128)
    (local $rr v128) (local $ri v128) (local $a v128) (local $b v128)
    (local.set $B (i32.shl (i32.and (i32.add (local.get $half) (i32.const 3)) (i32.const -2)) (i32.const 3)))
    (local.set $end (i32.shl (i32.add (local.get $half) (i32.const 1)) (i32.const 3)))
    (loop $k
      (local.set $m (v128.load (i32.add (i32.shl (local.get $B) (i32.const 1)) (local.get $o))))
      (local.set $on (f64x2.gt (local.get $m) (v128.const f64x2 0 0)))
      (local.set $re (v128.load (local.get $o)))
      (local.set $im (v128.load (i32.add (local.get $B) (local.get $o))))
      (local.set $fr (v128.load (i32.add (local.get $J) (local.get $o))))
      (local.set $fi (v128.load (i32.add (i32.add (local.get $J) (local.get $B)) (local.get $o))))
      (local.set $rr (f64x2.div (f64x2.add (f64x2.mul (local.get $re) (local.get $fr)) (f64x2.mul (local.get $im) (local.get $fi))) (local.get $m)))
      (local.set $ri (f64x2.div (f64x2.sub (f64x2.mul (local.get $im) (local.get $fr)) (f64x2.mul (local.get $re) (local.get $fi))) (local.get $m)))
      (local.set $q (i32.add (i32.add (local.get $J) (i32.shl (local.get $B) (i32.const 1))) (local.get $o)))
      (local.set $c (i32.const 0))
      (loop $ch
        (local.set $a (v128.load (local.get $q)))
        (local.set $b (v128.load (i32.add (local.get $q) (local.get $B))))
        (v128.store (local.get $q) (v128.bitselect
          (f64x2.sub (f64x2.mul (local.get $a) (local.get $rr)) (f64x2.mul (local.get $b) (local.get $ri))) (local.get $a) (local.get $on)))
        (v128.store (i32.add (local.get $q) (local.get $B)) (v128.bitselect
          (f64x2.add (f64x2.mul (local.get $a) (local.get $ri)) (f64x2.mul (local.get $b) (local.get $rr))) (local.get $b) (local.get $on)))
        (local.set $q (i32.add (local.get $q) (i32.shl (local.get $B) (i32.const 2))))
        (br_if $ch (i32.lt_s (local.tee $c (i32.add (local.get $c) (i32.const 1))) (local.get $nch))))
      (br_if $k (i32.lt_s (local.tee $o (i32.add (local.get $o) (i32.const 16))) (local.get $end)))))
)
