{
  "name": "@audio/spectral",
  "version": "1.3.0",
  "type": "module",
  "sideEffects": false,
  "description": "Spectral features — umbrella for @audio/spectral-* atoms (centroid, spread, flatness, rolloff, flux, slope, crest, zcr)",
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "audio",
    "dsp",
    "spectral",
    "features",
    "mir"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./members/*.d.ts",
      "default": "./members/*.js"
    }
  },
  "files": [
    "index.js",
    "*.d.ts",
    "members/"
  ],
  "scripts": {
    "test": "node test.js",
    "test:all": "npm test --workspaces --if-present && npm test",
    "publish:all": "npm publish --workspaces && npm publish",
    "members": "node scripts/members.js",
    "prepublishOnly": "node scripts/members.js --check"
  },
  "dependencies": {
    "@audio/spectral-centroid": "^1.0.3",
    "@audio/spectral-contrast": "^1.1.4",
    "@audio/spectral-cqt": "^1.0.2",
    "@audio/spectral-crest": "^1.0.3",
    "@audio/spectral-edit": "^1.0.3",
    "@audio/spectral-flatness": "^1.0.3",
    "@audio/spectral-flux": "^1.1.5",
    "@audio/spectral-freeze": "^1.0.2",
    "@audio/spectral-harmonics": "^1.0.3",
    "@audio/spectral-ltas": "^1.1.5",
    "@audio/spectral-mfcc": "^1.0.3",
    "@audio/spectral-pvoc": "^1.1.1",
    "@audio/spectral-rolloff": "^1.1.5",
    "@audio/spectral-slope": "^1.1.5",
    "@audio/spectral-spread": "^1.1.5",
    "@audio/spectral-target": "^1.1.0",
    "@audio/spectral-zcr": "^1.0.3"
  },
  "devDependencies": {
    "fourier-transform": "^2.2.0",
    "tst": "^9.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/spectral.git"
  },
  "funding": "https://github.com/sponsors/audiojs",
  "types": "./index.d.ts"
}
